# bidceleb environment contract — NAMES ONLY, NEVER VALUES.
#
# Copy to .env locally. Every variable here is documented with a verification step in
# docs/env-matrix.md. The app FAILS TO START when a required one is missing — that is
# deliberate; a silent default is how a prod outage starts.

# --- Database: Supabase, via the SESSION pooler (port 5432, NOT 6543) --------
# Three traps, all of which fail confusingly — see docs/env-matrix.md on `main`:
#   1. Direct connections are IPv6-only without a paid add-on.
#   2. Transaction mode (6543) has no prepared statements; Hibernate and Flyway
#      both need them. Same host, different port, different semantics.
#   3. Flyway's advisory lock is connection-scoped, so transaction pooling can
#      release it on a different backend than took it.
# Supabase gives you a libpq URL; this is JDBC. Prepend jdbc: and drop any
# embedded user:password@.
BIDCELEB_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
BIDCELEB_DB_USERNAME=postgres.<project-ref>
BIDCELEB_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY
# Sized against the DATABASE's limit, not expected load. 2 on Render free.
BIDCELEB_DB_POOL_MAX=5

# --- Payments ---------------------------------------------------------------
# The provider's base URL, display name and WHICH env var holds its key are
# columns in payment_provider_config, not here — switching provider must be an
# UPDATE, not a release. The row stores the variable's NAME, never its value, so
# a database backup is never a credential leak.
#
# Locally: use the provider's TEST-MODE key, or leave both blank and run the
# STUB adapter, which settles synchronously and needs no network.
#
# Until a real key is set, leave payment_provider_config.active = false for every
# live provider. A provider marked active with no key fails at request time —
# that is, in front of a paying user — instead of at startup.
BIDCELEB_PAYMENT_API_KEY=CHANGE_ME_LOCAL_ONLY

# ⚠️ TOP-TIER CREDENTIAL. Popularity is minted by exactly one code path: a
# signature-verified webhook. Whoever holds this can forge settlements and award
# unlimited popularity without paying, and it is invisible in the provider's
# dashboard because no payment ever existed. Rotate on any suspicion.
BIDCELEB_PAYMENT_WEBHOOK_SECRET=CHANGE_ME_LOCAL_ONLY

# --- Firebase (identity) — sign-in is OPTIONAL ------------------------------
# Anyone can boost without an account; signing in only claims boost history.
# The backend verifies ID tokens and never issues them. The project id is NOT a
# secret, and there is NO service-account key anywhere in this system.
#
# Absence is meaningful: with no project id there is no token decoder, so
# authenticated routes fail closed while the board and boosting keep working.
# A WRONG project id does not fail loudly — tokens are rejected as
# wrong-audience, which reads to a user as "my login is broken".
BIDCELEB_FIREBASE_PROJECT_ID=

# --- Runtime ----------------------------------------------------------------
BIDCELEB_PORT=8080
BIDCELEB_LOG_LEVEL=INFO
# Origin only, no trailing slash, no path. Used to build checkout return URLs
# and OG image URLs — a wrong value sends paying users to a 404.
BIDCELEB_PUBLIC_BASE_URL=https://<your-service>.onrender.com

# --- NOT env vars -----------------------------------------------------------
# Anything governing PRICING, a LIMIT or a KILL SWITCH lives in app_config so it
# can be changed during an incident without a deploy. See docs/env-matrix.md:
#   payments.enabled                  stops TAKING money, never serving
#   boost.min.cents                   floor for one boost, and the empty-tab target
#   boost.outbid.rate.bps             increment rate in basis points (500 = 5%)
#   boost.outbid.cap.cents            increment ceiling (5000 = $50)
#   boost.outbid.min.increment.cents  increment floor (100 = $1)
#   boost.max.cents                   sanity ceiling on one boost
#   listing.price.cents               what adding a celebrity costs today
#   listing.list.price.cents          the struck-through "was" price
#   listing.enabled                   accept new submissions at all
#   leaderboard.page.size.max         paging ceiling
#   watch.*                           alert thresholds; watch.enabled silences the
#                                     WARNING, not the limit
