# Drovi environment contract — NAMES ONLY, NEVER VALUES.
#
# Copy to .env locally. Every variable here is documented with a verification
# step in docs/env-matrix.md. The app FAILS TO START when a required one is
# missing — that is deliberate; a silent default is how a prod outage starts.

# --- Database: Supabase, via the SESSION pooler (port 5432, NOT 6543) --------
# Three traps, all of which fail confusingly:
#   1. Direct connections are IPv6-only without a paid add-on — most hosts have
#      no IPv6 egress, and the error looks like a firewall problem.
#   2. Transaction mode (6543) has no prepared statements. Hibernate and Flyway
#      both need them. Same host, different port, different semantics.
#   3. Flyway's advisory lock is connection-scoped, so transaction pooling can
#      release it on a different backend than took it.
DROVI_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DROVI_DB_USERNAME=postgres.<project-ref>
DROVI_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY
# Sized against the DATABASE's limit, not expected load. 2 on Render free.
DROVI_DB_POOL_MAX=5

# --- Model provider ---------------------------------------------------------
# The base URL, model and auth header NAME live in the ai_provider_config table,
# not here — switching provider or model must be an UPDATE, not a release. Only
# the secret is an environment variable, and the row names which one
# (ai_provider_config.api_key_env_var).
#
# Until this is set, leave ai_provider_config.active = false. A provider marked
# active with no key fails every call at request time instead of at startup,
# which is the worse failure.
DROVI_GEMINI_API_KEY=CHANGE_ME_LOCAL_ONLY

# --- Firebase (identity) — NOT YET WIRED ------------------------------------
# Firebase owns authentication: the backend verifies ID tokens and never issues
# them. No password, no session, no token minting anywhere in this system.
DROVI_FIREBASE_PROJECT_ID=
DROVI_FIREBASE_CREDENTIALS_B64=CHANGE_ME_LOCAL_ONLY

# --- Runtime ----------------------------------------------------------------
DROVI_PORT=8080
DROVI_LOG_LEVEL=INFO
# Origin only, no path. This is what users paste before /s/<project-key>.
DROVI_PUBLIC_BASE_URL=https://<your-service>.onrender.com

# --- NOT env vars -----------------------------------------------------------
# Anything governing SPEND or runtime behaviour lives in the app_config table so
# it can be changed during an incident without a deploy:
#   ai.enabled                        master kill switch
#   ai.daily.cost.cap.micros          platform ceiling
#   ai.account.daily.cost.cap.micros  per-account ceiling
#   ai.model.<PURPOSE>                per-purpose model routing
#   runtime.max.page.size             sandbox paging ceiling
#   runtime.unmatched.status          status when no endpoint matches
